# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL (used by the postgres service and injected into backend) ---
POSTGRES_DB=vulncheck
POSTGRES_USER=vulncheck
# Required, no default (docker-compose.yml/application.yml no longer fall back to anything if this
# is unset) — pick a strong password, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- App secrets/config (see backend/src/main/resources/application.yml) ---
# Required, no default. AES-256-GCM key encrypting user_secrets.encrypted_key (stored Claude/NVD
# API keys). SecretEncryptionService fails fast at startup if this is blank or matches a retired
# default's hash. Generate a fresh 32-byte base64 value: openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=
# The one login email granted ROLE_ADMIN (required for /admin/**: CPE dictionary sync, CVE.org
# sync). Empty = no admin account at all, which is the safe default.
ADMIN_EMAIL=
# Research jobs older than this many days are auto-deleted daily (04:00 UTC). 0/negative disables.
JOB_RETENTION_DAYS=30

# --- Everything below is optional: every one of these has a working default baked into
# docker-compose.yml/application.yml, so leaving it commented out (or unset) is fine. They're
# listed here so a deployer can discover and tune them without reading docker-compose.yml/
# application.yml directly (closed-mode backlog item 391). Keep this list 1:1 with
# docker-compose.yml's backend service `environment:` block -- if you add a var to one, add it to
# the other in the same change.

# --- CPE Dictionary mirror sync (see docs/spec/cpe-dictionary-mirror-plan.md) ---
# One-shot full mirror sync on boot (hours). Safe to leave true once the weekly delta chain runs --
# the freshness gate below skips it whenever the mirror is already up to date.
CPE_FULL_SYNC_ON_STARTUP=false
# Skips the startup full sync above when the mirror's last unfiltered sync is within this many
# days. 0/negative disables the gate (every enabled startup always runs the full sync).
CPE_FULL_SYNC_MAX_AGE_DAYS=30
# Weekly automatic full re-sync (default: Sunday 01:30 UTC, ~103 min). Off by default; enabling it
# is an operational decision.
CPE_SCHEDULED_RESYNC_ENABLED=false
# Overrides the cron above. Must be strictly after this instance's own start time or the trigger
# silently never fires.
CPE_SCHEDULED_RESYNC_CRON=0 30 1 * * SUN

# --- AI cost/throughput tuning (see docs/spec/closed-mode-plan.md §7) ---
# Per-item AI-spend cap (see JobCostBudgetService#costCapPerItemUsd). Only raise for a throwaway
# diagnostic job made entirely of AI-eligible items.
APP_COST_CAP_PER_ITEM_USD=0.005
# Per-item parallelism within a single job. Only raise after measuring HikariCP connection-acquire
# p95 under load, and keep SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE comfortably above it.
ITEM_PROCESSING_POOL_SIZE=8
# HikariCP max pool size. Keep comfortably above ITEM_PROCESSING_POOL_SIZE above.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20

# --- Web/session tuning ---
# Thymeleaf template cache. Set to false only for a deliberate template-focused debugging session
# (templates are baked into the image and never edited live in the running container otherwise).
THYMELEAF_CACHE_ENABLED=true
# Secure attribute on the session cookie. False by default because the bundled docker-compose.yml
# has no TLS termination -- set to true only once this deployment sits behind TLS, otherwise logins
# will silently stop working.
SESSION_COOKIE_SECURE=false

# --- Registry mirror sync (npm/PyPI/Maven/etc., see application.yml) ---
# Weekly automatic full re-sync of the registry mirrors. Off by default, same safety-first
# convention as the CPE resync flags above; can also be triggered on demand via
# /admin/registry-mirror.
REGISTRY_MIRROR_SCHEDULED_SYNC_ENABLED=false
REGISTRY_MIRROR_SCHEDULED_SYNC_CRON=0 0 2 * * SUN
REGISTRY_MIRROR_SYNC_CHUNK_SIZE=200
REGISTRY_MIRROR_SYNC_FRESHNESS_DAYS=7

# --- NVD CVE API bulk mirror backfill/delta (see docs/spec/closed-mode backlog item 202/284) ---
# Off by default. The ~2-3GB storage impact is on top of this app's 15GB DB size hard cap, so
# growing this mirror must be a deliberate per-environment opt-in, same convention as every other
# *-mirror-enabled/*-scheduled-resync-enabled flag above. Also triggerable on demand via the
# /admin/nvd-cve sync-now button regardless of this setting.
NVD_CVE_BACKFILL_ENABLED=false
NVD_CVE_BACKFILL_CRON=0 0 6 * * *
NVD_CVE_BACKFILL_MAX_REQUESTS_PER_RUN=60
NVD_CVE_BACKFILL_MAX_DURATION_MINUTES=60
NVD_CVE_DELTA_ENABLED=false
NVD_CVE_DELTA_CRON=0 30 6 * * *
NVD_CVE_DELTA_MAX_REQUESTS_PER_RUN=60
NVD_CVE_DELTA_MAX_DURATION_MINUTES=60
