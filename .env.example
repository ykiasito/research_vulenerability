# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL (used by the postgres service and injected into backend) ---
POSTGRES_DB=vulncheck
POSTGRES_USER=vulncheck
# Required, no default (docker-compose.yml/application.yml no longer fall back to anything if this
# is unset) — pick a strong password, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- App secrets/config (see backend/src/main/resources/application.yml) ---
# Required, no default. AES-256-GCM key encrypting user_secrets.encrypted_key (stored Claude/NVD
# API keys). SecretEncryptionService fails fast at startup if this is blank or matches a retired
# default's hash. Generate a fresh 32-byte base64 value: openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=
# The one login email granted ROLE_ADMIN (required for /admin/**: CPE dictionary sync, CVE.org
# sync). Empty = no admin account at all, which is the safe default.
ADMIN_EMAIL=
# Research jobs older than this many days are auto-deleted daily (04:00 UTC). 0/negative disables.
JOB_RETENTION_DAYS=30
